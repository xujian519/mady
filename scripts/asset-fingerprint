#!/usr/bin/env bash
# 生成或校验随包领域资产（法条、费用、日历、模板以外的 YAML/JSON）的指纹清单。
#
# 用法：
#   scripts/asset-fingerprint            # 生成默认清单
#   scripts/asset-fingerprint --check    # 校验，漂移时退出码 1
#   scripts/asset-fingerprint --root DIR --output FILE
#
# 为什么需要：随包资产是从官方文书逐字转录的，手改会与来源漂移。清单纳入 CI 后，
# 任何资产变更都必须显式更新清单并在 PR 说明变更依据（文号/版本/核验日期）。
#
# 扫描范围：只含「从官方文书逐字转录」的事实索引，见 docs/design/index-asset-format.md。
# 规则包、模板等手写资产不在其中——它们随代码演进，纳入指纹只会制造无效告警。

set -uo pipefail

ROOT=""
OUTPUT="data/ASSETS.sha256"
CHECK=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) CHECK=1; shift ;;
    --root) ROOT="${2:?--root 需要参数}"; shift 2 ;;
    --output) OUTPUT="${2:?--output 需要参数}"; shift 2 ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

if command -v sha256sum >/dev/null 2>&1; then
  hash_file() { sha256sum "$1" | awk '{print $1}'; }
elif command -v shasum >/dev/null 2>&1; then
  hash_file() { shasum -a 256 "$1" | awk '{print $1}'; }
else
  echo "需要 sha256sum 或 shasum" >&2
  exit 2
fi

# 转录类事实索引的固定位置。新增一类资产时同时更新此处与格式文档。
ASSET_DIRS=(
  data/law
  pkg/lawcite/data
  domains/fees/data
  domains/deadline/data
)

# 扫描目录：显式 --root 时只扫它；否则只扫白名单中存在的目录。
scan_dirs() {
  if [[ -n "$ROOT" ]]; then
    printf '%s\n' "$ROOT"
    return
  fi
  local dir
  for dir in "${ASSET_DIRS[@]}"; do
    [[ -d "$dir" ]] && printf '%s\n' "$dir"
  done
}

collect() {
  local dir="$1"
  find "$dir" -type f \( -name '*.yaml' -o -name '*.yml' -o -name '*.json' \) \
    ! -name 'ASSETS.sha256' ! -name '.DS_Store' 2>/dev/null
}

generate() {
  local dirs
  dirs=$(scan_dirs)
  if [[ -z "$dirs" ]]; then
    return 0
  fi
  printf '%s\n' "$dirs" | while IFS= read -r dir; do
    collect "$dir"
  done | sort | while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    printf '%s  %s\n' "$(hash_file "$file")" "$file"
  done
}

if [[ $CHECK -eq 1 ]]; then
  if [[ ! -f "$OUTPUT" ]]; then
    echo "缺少指纹清单：$OUTPUT（先运行 scripts/asset-fingerprint）" >&2
    exit 1
  fi
  tmp=$(mktemp "${TMPDIR:-/tmp}/asset-fingerprint.XXXXXX") || {
    echo "无法创建临时文件（TMPDIR=${TMPDIR:-/tmp}）" >&2
    exit 2
  }
  trap 'rm -f "$tmp"' EXIT
  generate >"$tmp"
  if ! diff -u "$OUTPUT" "$tmp" >/dev/null 2>&1; then
    echo "资产指纹漂移：" >&2
    diff -u "$OUTPUT" "$tmp" >&2 || true
    echo "如为有意变更，运行 scripts/asset-fingerprint 更新清单并在 PR 说明依据。" >&2
    exit 1
  fi
  echo "资产指纹校验通过（$(wc -l <"$OUTPUT" | tr -d ' ') 个文件）"
  exit 0
fi

mkdir -p "$(dirname "$OUTPUT")"
generate >"$OUTPUT"
count=$(wc -l <"$OUTPUT" | tr -d ' ')
echo "已生成 $OUTPUT（$count 个文件）"
